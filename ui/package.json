{
  "name": "qrng-demo-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:web": "tsc -b && vite build --mode web",
    "preview:web": "npm run build:web && vite preview --mode web",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.87.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3"
  },
  "engines": {
    "node": ">=24"
  }
}
